# ===== Postgres =====
POSTGRES_USER=finllm
POSTGRES_PASSWORD=finllm
POSTGRES_DB=finllm
POSTGRES_PORT=5432

# ===== Ollama =====
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_PORT=11434
# Modelos baixados automaticamente pelo serviço model-puller (separados por espaço)
OLLAMA_MODELS=bge-m3 qwen3:8b
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=30m
# Mac (Ollama nativo, com GPU Metal): use http://host.docker.internal:11434
# e suba apenas: docker compose up -d postgres app   (veja `make up-mac`)
OLLAMA_BASE_URL=http://ollama:11434

# ===== App (lido por finllm/config.py) =====
LLM_MODEL=qwen3:8b
EMBED_MODEL=bge-m3
EMBED_DIM=1024
LLM_NUM_CTX=8192
LLM_TEMPERATURE=0.0
LLM_SEED=42
# false desliga o "thinking" (recomendado p/ extração com JSON schema). Vazio = padrão do modelo.
LLM_THINK=false
RAG_TOP_K=6
CHUNK_MAX_CHARS=2500
# Categorias IPE a indexar (separadas por vírgula). Veja: finllm cvm ipe-categories
IPE_CATEGORIES=Fato Relevante,Comunicado ao Mercado
